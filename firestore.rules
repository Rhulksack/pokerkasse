rules_version = '2';
// Pokerkasse – Zugriffsregeln
// Owner: der Account "max" (meta/owner, einmalig gesetzt). Admins: role == 'admin' (nur der Owner vergibt das).
// Mitglieder sehen alles erst, wenn ein Admin ihren Spieler-Claim freigegeben hat. Schreiben dürfen nur Admins.
service cloud.firestore {
  match /databases/{db}/documents {
    function signed() { return request.auth != null; }
    function ownerDoc() { return /databases/$(db)/documents/meta/owner; }
    function userDoc() { return /databases/$(db)/documents/users/$(request.auth.uid); }
    function isOwner() { return signed() && exists(ownerDoc()) && get(ownerDoc()).data.uid == request.auth.uid; }
    function isAdmin() { return isOwner() || (signed() && exists(userDoc()) && get(userDoc()).data.role == 'admin'); }
    function approved() { return isAdmin() || (signed() && exists(userDoc()) && get(userDoc()).data.approved == true); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    match /meta/{doc} {
      allow read: if doc == 'owner' ? signed() : approved();
      allow create: if doc == 'owner'
        ? (signed() && request.auth.token.email == 'max@pokerkasse.invalid'
           && request.resource.data.uid == request.auth.uid && request.resource.data.keys().hasOnly(['uid', 'at']))
        : isAdmin();
      allow update, delete: if doc != 'owner' && isAdmin();
    }

    match /users/{uid} {
      allow read: if signed() && (request.auth.uid == uid || isAdmin());
      allow create: if signed() && request.auth.uid == uid
        && request.resource.data.role == 'member' && request.resource.data.approved == false
        && request.resource.data.playerId == null;
      allow update: if signed() && (
           (request.auth.uid == uid && changed().hasOnly(['claim', 'seenAt']))
        || (isAdmin() && changed().hasOnly(['approved', 'playerId', 'claim']))
        || isOwner());
      allow delete: if signed() && (request.auth.uid == uid || isOwner()
        || (isAdmin() && resource.data.role != 'admin'));
    }

    match /players/{id} {
      allow read: if signed();
      allow write: if isAdmin();
    }

    match /games/{id} {
      allow read: if approved();
      allow write: if isAdmin();
    }
  }
}
