{
  "name": "pokerkasse",
  "version": "1.7.2",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win portable nsis"
  },
  "keywords": [],
  "author": "Pokerkasse",
  "license": "ISC",
  "description": "Verwaltung von Poker-Homegames",
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "qrcode": "^1.5.4"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "productName": "Pokerkasse",
  "build": {
    "appId": "de.pokerkasse.app",
    "productName": "Pokerkasse",
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Pokerkasse-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Pokerkasse-Portable-${version}.exe"
    }
  }
}
